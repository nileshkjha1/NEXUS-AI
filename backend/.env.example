# NEXUS AI Configuration
APP_NAME="NEXUS AI"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL in production/docker, SQLite for local dev)
DATABASE_URL=sqlite:///./nexus_ai.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_ai

# JWT Authentication
JWT_SECRET_KEY=dev-jwt-secret-key-nexus-ai-change-in-production-123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & LLM Provider Configuration (Optional — fallback RAG active if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=auto
RAG_TOP_K=3

# Email Notifications (Optional SMTP setup)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
EMAILS_FROM=nexus-notifications@company.com
EMAILS_ENABLED=False

# CORS Allowed Origins (comma-separated)
# In production on Render, include your Vercel frontend URL:
# e.g., ALLOWED_ORIGINS="https://<your-nexus-frontend>.vercel.app,http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
